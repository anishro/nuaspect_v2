
# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Google Sheets / Forms live content sources.
# See GOOGLE_SETUP.md for how to create and fill in each of these.
# All must be prefixed with VITE_ so Vite exposes them to the browser bundle.
# The *_ENDPOINT_URL values are Apps Script Web App URLs (see setup guide) —
# the underlying Sheets themselves stay fully private, never shared publicly.
# ---------------------------------------------------------------------------

# Knowledge Hub articles (Apps Script Web App reading a private sheet with
# columns: title, category, summary, link, date)
VITE_KNOWLEDGE_HUB_ENDPOINT_URL=""

# Academy courses (Apps Script Web App reading a private sheet with
# columns: title, category, description, youtube)
VITE_ACADEMY_ENDPOINT_URL=""

# Assessment quiz questions (Apps Script Web App reading a private sheet with
# columns: id, category, question, optiona, optionb, optionc, optiond, correctkey)
VITE_QUIZ_ENDPOINT_URL=""

# Contact form (Google Form "formResponse" endpoint + entry.XXXXXXX field IDs)
VITE_CONTACT_FORM_ACTION_URL=""
VITE_CONTACT_FORM_NAME_ENTRY=""
VITE_CONTACT_FORM_EMAIL_ENTRY=""
VITE_CONTACT_FORM_MESSAGE_ENTRY=""

# "Write to Us" newsletter pill on the Home page (Google Form "formResponse"
# endpoint + entry.XXXXXXX field ID for the single Email question). The linked
# Sheet has an Apps Script trigger that emails a welcome template to each signup.
VITE_NEWSLETTER_FORM_ACTION_URL=""
VITE_NEWSLETTER_FORM_EMAIL_ENTRY=""
